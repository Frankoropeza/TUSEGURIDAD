---
import BaseLayout from '@layouts/BaseLayout.astro';
import EmpresaCard from '@components/EmpresaCard.astro';
import CategoriaCard from '@components/CategoriaCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@config/site';

const todasCategorias = (await getCollection('categorias')).sort(
  (a, b) => a.data.orden - b.data.orden
);
const categoriasActivas = todasCategorias.filter((c) => c.data.destacada);
const categoriasProximas = todasCategorias.filter((c) => !c.data.destacada);

const empresas = (await getCollection('empresas')).sort(
  (a, b) => b.data.orden - a.data.orden
);
const empresasDestacadas = empresas.filter(
  (e) => e.data.destacado || e.data.verificado
);

const ciudades = (await getCollection('ciudades')).sort(
  (a, b) => a.data.orden - b.data.orden
);

const servicios = (await getCollection('servicios'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);

const guias = (await getCollection('guias'))
  .filter((g) => !g.data.draft)
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);

const nombreCategoria = new Map(todasCategorias.map((c) => [c.id, c.data.nombre]));
const nombreCiudad = new Map(ciudades.map((c) => [c.id, c.data.nombre]));

const pasos = [
  {
    numero: '01',
    titulo: 'Busca por categoría o ciudad',
    texto:
      'Explora el directorio por tipo de servicio —seguridad privada, protección contra incendios— o por la ciudad donde lo necesitas.',
  },
  {
    numero: '02',
    titulo: 'Compara proveedores',
    texto:
      'Revisa fichas con servicios, zonas de cobertura, horarios y datos de contacto. Identifica a las empresas verificadas por nuestro equipo.',
  },
  {
    numero: '03',
    titulo: 'Contacta directo, sin intermediarios',
    texto:
      'Llama, escribe por WhatsApp o visita el sitio del proveedor. El contacto es directo y sin costo para ti.',
  },
];

const compromisos = [
  {
    icono: '✅',
    titulo: 'Proveedores verificados',
    texto:
      'Distinguimos con una insignia a las empresas que acreditan registro, permisos y datos de contacto reales.',
  },
  {
    icono: '🆓',
    titulo: 'Gratis para quien busca',
    texto:
      'Consultar el directorio y contactar proveedores no tiene ningún costo. Sin registros forzosos ni datos a cambio.',
  },
  {
    icono: '🇲🇽',
    titulo: 'Cobertura en México',
    texto:
      'Empezamos por la Ciudad de México y su zona metropolitana, con expansión gradual a más ciudades del país.',
  },
  {
    icono: '📋',
    titulo: 'Información útil y sin humo',
    texto:
      'Publicamos guías prácticas de contratación y normativa para que decidas con criterio, no con miedo.',
  },
];
---

<BaseLayout title="Inicio" path="/" pageType="website">
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-b from-brand-950 via-brand-900 to-brand-800">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>
    <div class="container-x relative py-20 sm:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <p class="badge mx-auto border border-white/20 bg-white/10 text-white">
          Directorio de seguridad en México
        </p>
        <h1 class="mt-6 text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl">
          Encuentra empresas de seguridad <span class="text-accent-500">confiables</span> para tu negocio u hogar
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brand-100">
          Compara proveedores de seguridad privada y protección contra incendios: fichas completas, zonas de cobertura y contacto directo, sin intermediarios.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/categorias" class="btn bg-accent-500 px-7 py-3 text-base text-ink-900 hover:bg-accent-600">
            Explorar el directorio
          </a>
          <a href="/registrar" class="btn border border-white/30 px-7 py-3 text-base text-white hover:bg-white/10">
            Registrar mi empresa
          </a>
        </div>
        <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-brand-100">
          <li class="flex items-center gap-2"><span class="text-accent-500">✓</span> Sin costo para quien busca</li>
          <li class="flex items-center gap-2"><span class="text-accent-500">✓</span> Contacto directo con el proveedor</li>
          <li class="flex items-center gap-2"><span class="text-accent-500">✓</span> Empresas verificadas</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ CATEGORÍAS ============ -->
  <section class="container-x py-16 sm:py-20" aria-labelledby="categorias-title">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="categorias-title" class="text-3xl font-bold sm:text-4xl">¿Qué tipo de seguridad necesitas?</h2>
      <p class="mt-3 text-ink-700">
        Empezamos con las dos categorías más solicitadas. Muy pronto sumaremos más especialidades.
      </p>
    </div>

    <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2">
      {categoriasActivas.map((cat) => (
        <a
          href={`/categorias/${cat.id}`}
          class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg"
        >
          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-brand-50 text-3xl">
            {cat.data.icono ?? '🛡️'}
          </div>
          <h3 class="mt-5 text-xl font-semibold text-ink-900 group-hover:text-brand-700">
            {cat.data.nombre}
          </h3>
          <p class="mt-2 flex-1 leading-relaxed text-ink-700">{cat.data.descripcion}</p>
          <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 group-hover:text-brand-700">
            Ver empresas <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        </a>
      ))}
    </div>

    {categoriasProximas.length > 0 && (
      <div class="mx-auto mt-10 max-w-4xl text-center">
        <p class="text-sm font-medium text-ink-700">Próximamente:</p>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {categoriasProximas.map((cat) => (
            <span class="badge border border-slate-200 bg-slate-50 text-ink-700">
              {cat.data.icono} {cat.data.nombre}
            </span>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- ============ CÓMO FUNCIONA ============ -->
  <section class="border-y border-slate-200 bg-slate-50" aria-labelledby="como-funciona-title">
    <div class="container-x py-16 sm:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="como-funciona-title" class="text-3xl font-bold sm:text-4xl">Cómo funciona</h2>
        <p class="mt-3 text-ink-700">Tres pasos para encontrar al proveedor de seguridad correcto.</p>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {pasos.map((paso) => (
          <div class="relative rounded-2xl border border-slate-200 bg-white p-7">
            <span class="text-4xl font-extrabold tracking-tight text-brand-100">{paso.numero}</span>
            <h3 class="mt-3 text-lg font-semibold text-ink-900">{paso.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700">{paso.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EMPRESAS DESTACADAS (condicional) ============ -->
  {empresasDestacadas.length > 0 && (
    <section class="container-x py-16 sm:py-20" aria-labelledby="empresas-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="empresas-title" class="text-3xl font-bold sm:text-4xl">Empresas destacadas</h2>
          <p class="mt-2 text-ink-700">Proveedores verificados y destacados del directorio.</p>
        </div>
        <a href="/empresas" class="btn-outline">Ver todas las empresas</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {empresasDestacadas.slice(0, 6).map((e) => (
          <EmpresaCard
            nombre={e.data.nombre}
            descripcion={e.data.descripcion}
            href={`/empresas/${e.id}`}
            categoria={nombreCategoria.get(e.data.categoria)}
            ciudad={nombreCiudad.get(e.data.ciudad)}
            verificado={e.data.verificado}
            destacado={e.data.destacado}
            logo={e.data.logo}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ============ COMPROMISOS / POR QUÉ ============ -->
  <section class="container-x py-16 sm:py-20" aria-labelledby="compromisos-title">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      <div class="lg:sticky lg:top-24">
        <h2 id="compromisos-title" class="text-3xl font-bold sm:text-4xl">
          Un directorio hecho para decidir con confianza
        </h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          La seguridad no se contrata a ciegas. En {SITE.name} reunimos proveedores de seguridad en un solo lugar, con información clara y comparable, para que elijas con criterio y contactes directo a la empresa.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/categorias" class="btn-primary">Buscar proveedor</a>
          <a href="/guias" class="btn-outline">Leer nuestras guías</a>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {compromisos.map((item) => (
          <div class="card">
            <span class="text-2xl">{item.icono}</span>
            <h3 class="mt-3 text-base font-semibold text-ink-900">{item.titulo}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-700">{item.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SERVICIOS ============ -->
  {servicios.length > 0 && (
    <section class="border-y border-slate-200 bg-slate-50" aria-labelledby="servicios-title">
      <div class="container-x py-16 sm:py-20">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 id="servicios-title" class="text-3xl font-bold sm:text-4xl">Servicios más solicitados</h2>
            <p class="mt-2 text-ink-700">Te conectamos con proveedores para estos servicios.</p>
          </div>
          <a href="/servicios" class="btn-outline">Todos los servicios</a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {servicios.map((s) => (
            <a href={`/servicios/${s.id}`} class="card group">
              <span class="text-3xl">{s.data.icono ?? '🔒'}</span>
              <h3 class="mt-4 text-base font-semibold text-ink-900 group-hover:text-brand-700">
                {s.data.titulo}
              </h3>
              <p class="mt-1.5 line-clamp-3 text-sm leading-relaxed text-ink-700">{s.data.descripcion}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-brand-600 group-hover:text-brand-700">
                Solicitar cotización →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ GUÍAS ============ -->
  {guias.length > 0 && (
    <section class="container-x py-16 sm:py-20" aria-labelledby="guias-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="guias-title" class="text-3xl font-bold sm:text-4xl">Guías y recursos</h2>
          <p class="mt-2 text-ink-700">Contenido práctico para contratar seguridad con criterio.</p>
        </div>
        <a href="/guias" class="btn-outline">Ver todas las guías</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {guias.map((g) => (
          <a href={`/guias/${g.id}`} class="card group flex flex-col">
            <p class="text-xs font-medium uppercase tracking-wide text-brand-600">
              {g.data.fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h3 class="mt-2 text-base font-semibold text-ink-900 group-hover:text-brand-700">
              {g.data.titulo}
            </h3>
            <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-ink-700">{g.data.descripcion}</p>
            <span class="mt-4 text-sm font-semibold text-brand-600 group-hover:text-brand-700">Leer guía →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ============ CTA PROVEEDORES ============ -->
  <section class="container-x pb-16 sm:pb-20" aria-labelledby="cta-title">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-900 to-brand-700 px-8 py-14 text-center sm:px-14">
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.07]"
        style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 28px 28px;"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-2xl">
        <h2 id="cta-title" class="text-3xl font-bold text-white sm:text-4xl">
          ¿Tienes una empresa de seguridad?
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-brand-100">
          Registra tu empresa en {SITE.name} y recibe clientes que ya están buscando tus servicios. Publica tu ficha con servicios, cobertura y contacto directo.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/registrar" class="btn bg-accent-500 px-7 py-3 text-base text-ink-900 hover:bg-accent-600">
            Registrar mi empresa
          </a>
          <a href="/contacto" class="btn border border-white/30 px-7 py-3 text-base text-white hover:bg-white/10">
            Hablar con nosotros
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
