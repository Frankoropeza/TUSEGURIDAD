---
import { SITE } from '@config/site';
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, v]) => Boolean(v));
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div class="container-x grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <a href="/" class="flex items-center gap-2 font-bold text-ink-900">
        <img src="/favicon.svg" alt="" width="26" height="26" />
        <span>{SITE.name}</span>
      </a>
      <p class="mt-3 max-w-xs text-sm text-ink-700">{SITE.tagline}.</p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-ink-900">Explorar</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {SITE.nav.map((item) => (
          <li><a href={item.href} class="text-ink-700 hover:text-brand-700">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-ink-900">Sitio</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {SITE.navFooter.map((item) => (
          <li><a href={item.href} class="text-ink-700 hover:text-brand-700">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-ink-900">Contacto</h3>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        {SITE.contacto.email && (
          <li><a href={`mailto:${SITE.contacto.email}`} class="hover:text-brand-700">{SITE.contacto.email}</a></li>
        )}
        {SITE.contacto.telefono && (
          <li><a href={`tel:${SITE.contacto.telefono}`} class="hover:text-brand-700">{SITE.contacto.telefono}</a></li>
        )}
      </ul>
      {socials.length > 0 && (
        <div class="mt-4 flex gap-3">
          {socials.map(([name, url]) => (
            <a href={url} class="text-ink-700 hover:text-brand-700" rel="noopener">{name}</a>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="border-t border-slate-200">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-6 text-xs text-ink-700 sm:flex-row">
      <p>&copy; {year} {SITE.legalName}. Todos los derechos reservados.</p>
      <p>Hecho en México 🇲🇽</p>
    </div>
  </div>
</footer>
