---
interface Props {
  nombre: string;
  descripcion: string;
  href: string;
  icono?: string;
  total?: number;
}
const { nombre, descripcion, href, icono, total } = Astro.props;
---

<a href={href} class="card group flex flex-col">
  <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-2xl">
    {icono ?? '🛡️'}
  </div>
  <h3 class="mt-4 text-base font-semibold text-ink-900 group-hover:text-brand-700">{nombre}</h3>
  <p class="mt-1 line-clamp-2 flex-1 text-sm text-ink-700">{descripcion}</p>
  {typeof total === 'number' && (
    <p class="mt-3 text-xs font-medium text-ink-700">{total} {total === 1 ? 'empresa' : 'empresas'}</p>
  )}
</a>
