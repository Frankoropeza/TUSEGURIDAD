---
// PLACEHOLDER — se reemplaza en el siguiente paso (generación del index real).
// Existe solo para que `astro build` pase el gate del scaffold.
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@config/site';

const categorias = (await getCollection('categorias')).sort(
  (a, b) => a.data.orden - b.data.orden
);
---

<BaseLayout title="Inicio" path="/" pageType="website">
  <section class="container-x py-16 text-center">
    <p class="badge bg-brand-50 text-brand-700">Scaffold listo · Astro 6</p>
    <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-bold sm:text-5xl">
      {SITE.tagline}
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-ink-700">{SITE.description}</p>
    <p class="mt-6 text-sm text-ink-700">
      Placeholder temporal. {categorias.length} categorías cargadas desde content collections.
    </p>
  </section>
</BaseLayout>
