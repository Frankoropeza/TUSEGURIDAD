---
interface Props {
  indice: string;
  nombre: string;
  descripcion: string;
  href: string;
  categoria?: string;
  ciudad?: string;
  verificado?: boolean;
}
const { indice, nombre, descripcion, href, categoria, ciudad, verificado } = Astro.props;
---

<a href={href} class="idx-row grid grid-cols-12 items-baseline gap-x-4 gap-y-2 py-6 sm:py-7">
  <span class="label col-span-2 sm:col-span-1">{indice}</span>

  <span class="col-span-10 sm:col-span-4">
    <span class="display-md">{nombre}</span>
    {verificado && <span class="label ml-3 text-signal align-middle">Verificada</span>}
  </span>

  <span class="muted col-span-12 text-sm leading-snug sm:col-span-4">{descripcion}</span>

  <span class="col-span-12 flex items-baseline justify-between gap-4 sm:col-span-3 sm:justify-end">
    <span class="label muted">{[categoria, ciudad].filter(Boolean).join(' / ')}</span>
    <span class="idx-arrow label">→</span>
  </span>
</a>
