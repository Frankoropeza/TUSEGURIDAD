---
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Sidebar from '@components/Sidebar.astro';
import { SITE } from '@config/site';
import { buildSeo, type SeoInput } from '@lib/seo';

interface Props extends SeoInput {
  /** La portada va a todo lo ancho; el resto del sitio lleva barra lateral. */
  sidebar?: boolean;
}

const { sidebar = true } = Astro.props;
const seo = buildSeo(Astro.props);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {/* follow, no nofollow: la página no se indexa pero sus enlaces siguen
        transmitiendo señales al resto del sitio (variantes canonicalizadas
        y borradores legales). */}
    {seo.noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />

    {seo.schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    {sidebar ? (
      <main class="flex-1 con-sidebar">
        {/* El contenido va primero en el DOM (mejor para lectura y rastreo) y
            la columna de índice cae a la derecha en escritorio y debajo en
            móvil, sin necesidad de reordenar con CSS.
            El gap horizontal solo a partir de lg: en móvil las columnas se
            apilan y 11 huecos de 40px desbordarían el viewport. */}
        <div class="wrap grid grid-cols-12 gap-y-16 pt-8 lg:gap-x-12">
          <div class="contenido col-span-12 min-w-0 lg:col-span-8 xl:col-span-9">
            <slot />
          </div>
          <Sidebar />
        </div>
      </main>
    ) : (
      <main class="flex-1">
        <slot />
      </main>
    )}
    <Footer />
  </body>
</html>
