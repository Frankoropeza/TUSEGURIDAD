---
import type { ServicioDeclarado } from '@lib/servicios';
import { waServicio } from '@lib/servicios';

/**
 * Rejilla de servicios declarados por la empresa, en tarjetas.
 *
 * Va al inicio de la ficha: es lo primero que busca quien llega a la página
 * (qué hace esta empresa), antes que los datos administrativos.
 *
 * Cada tarjeta es un enlace de contacto con el mensaje ya escrito para ese
 * servicio. Si la empresa no declara WhatsApp se usa el teléfono; si no hay
 * ninguno, la tarjeta se renderiza sin enlace.
 */
interface Props {
  indice: string;
  servicios: ServicioDeclarado[];
  whatsapp?: string;
  telefono?: string;
  /** nombre de la plaza, para el mensaje de WhatsApp */
  plaza?: string;
  /** enlaces a páginas de servicio del directorio: [slug, título] */
  paginas?: { href: string; titulo: string }[];
}

const { indice, servicios, whatsapp, telefono, plaza, paginas = [] } = Astro.props;

const nn = (n: number): string => String(n).padStart(2, '0');

const enlace = (nombre: string): string | undefined => {
  if (whatsapp) return waServicio(whatsapp, nombre, plaza);
  if (telefono) return `tel:+52${telefono.replace(/\D/g, '')}`;
  return undefined;
};

const cta = whatsapp ? 'Cotizar por WhatsApp' : telefono ? 'Llamar' : '';

/* Celdas de relleno: la rejilla dibuja sus hairlines con el fondo asomando por
   el gap, así que un hueco al final de la última fila se vería como un bloque
   gris. Se tapa con celdas vacías del color del papel, visibles solo en el
   breakpoint donde ese hueco existe (2 columnas en sm, 3 en lg). */
const huecoSm = (2 - (servicios.length % 2)) % 2;
const huecoLg = (3 - (servicios.length % 3)) % 3;
const rellenos = Array.from({ length: Math.max(huecoSm, huecoLg) }, (_, i) => ({
  sm: i < huecoSm,
  lg: i < huecoLg,
}));
---

<section class="wrap pt-12 sm:pt-16">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b-2 border-ink pb-3">
    <p class="label">[ {indice} — Servicios que ofrece ]</p>
    <p class="label muted tabular-nums">{nn(servicios.length)} servicios declarados</p>
  </div>

  <div class="rejilla-serv mt-8">
    {servicios.map((s, i) => {
      const href = enlace(s.nombre);
      const Contenedor = href ? 'a' : 'div';
      return (
        <Contenedor
          href={href}
          rel={href?.startsWith('https') ? 'noopener' : undefined}
          class="tarjeta-serv"
          aria-label={href ? `${cta}: ${s.nombre}` : undefined}
        >
          <span class="label muted tabular-nums">{nn(i + 1)}</span>
          <h3 class="display-sm mt-3">{s.nombre}</h3>
          {s.descripcion && (
            <p class="muted mt-3 text-[13px] leading-[1.5]">{s.descripcion}</p>
          )}
          <span class="flex-1"></span>
          {href && (
            <span class="mt-5 flex items-center justify-between gap-3 border-t border-ink/15 pt-3">
              <span class="label">{cta}</span>
              <span class="label tarjeta-flecha">→</span>
            </span>
          )}
        </Contenedor>
      );
    })}

    {rellenos.map((r) => (
      <div
        aria-hidden="true"
        class:list={[
          'bg-paper',
          r.sm ? 'hidden sm:block' : 'hidden',
          r.lg ? 'lg:block' : 'lg:hidden',
        ]}
      ></div>
    ))}
  </div>

  {paginas.length > 0 && (
    <p class="mt-6 text-[13px] leading-[1.5]">
      <span class="label muted">Qué incluye cada servicio:</span>{' '}
      {paginas.map((p, i) => (
        <>
          {i > 0 && <span class="muted"> · </span>}
          <a href={p.href} class="text-signal underline-hover">{p.titulo}</a>
        </>
      ))}
    </p>
  )}

  <p class="muted mt-6 max-w-[68ch] text-[13px] leading-[1.5]">
    Los servicios y su alcance los declara la empresa. TuSeguridad no interviene en
    la contratación; confirma directamente con el proveedor la modalidad que ampara
    su permiso.
  </p>
</section>
