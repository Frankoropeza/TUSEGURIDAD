---
import Tarjeta from '@components/Tarjeta.astro';
import type { ServicioDeclarado } from '@lib/servicios';
import { slugServicio, waServicio } from '@lib/servicios';
import { FOTOS, foto as tomarFoto, fotoPara, tieneFotos } from '@lib/imagenes';

/**
 * Servicios declarados por la empresa, en la tarjeta del sistema (`Tarjeta`),
 * la misma de rubros, servicios, guías y fichas de empresa. Un solo lenguaje
 * de tarjeta en todo el sitio.
 *
 * Va al inicio de la ficha: quien llega buscando a la empresa quiere saber
 * primero qué hace, no su domicilio fiscal.
 *
 * Cada tarjeta enlaza al contacto con el mensaje ya escrito para ese servicio.
 * Si la empresa no declara WhatsApp se usa el teléfono; sin ninguno de los dos
 * la tarjeta se muestra sin enlace.
 */
interface Props {
  indice: string;
  servicios: ServicioDeclarado[];
  /** slug del rubro, para saber si hay fotografía disponible */
  rubro: string;
  /** nombre del rubro, para la línea meta de la tarjeta */
  rubroNombre?: string;
  whatsapp?: string;
  telefono?: string;
  /** correo, último recurso de contacto cuando no hay tel ni WhatsApp */
  email?: string;
  /** nombre de la plaza, para el mensaje de contacto */
  plaza?: string;
  /** enlaces a páginas de servicio del directorio */
  paginas?: { href: string; titulo: string }[];
  /**
   * Páginas propias del servicio dentro de esta empresa, por slug de servicio.
   * Cuando existe, la tarjeta lleva a la página en vez de a WhatsApp: es una
   * ruta indexable y la conversión ocurre dentro de ella.
   */
  fichas?: Map<string, string>;
}

const {
  indice,
  servicios,
  rubro,
  rubroNombre,
  whatsapp,
  telefono,
  email,
  plaza,
  paginas = [],
  fichas = new Map<string, string>(),
} = Astro.props;

/** misma línea meta que la tarjeta de empresa: rubro / plaza */
const meta = [rubroNombre, plaza].filter(Boolean).join(' / ');

const nn = (n: number): string => String(n).padStart(2, '0');
const hayFotos = tieneFotos(rubro);
const grupos = new Set(FOTOS.map((g) => g.slug));

/**
 * Destino de la tarjeta. Primero su página propia —es donde se explica y donde
 * se convierte—; si el servicio todavía no la tiene, cae al contacto directo
 * para que la tarjeta no quede muerta.
 */
const enlace = (nombre: string): string | undefined => {
  const propia = fichas.get(slugServicio(nombre));
  if (propia) return propia;
  if (whatsapp) return waServicio(whatsapp, nombre, plaza);
  if (telefono) return `tel:+52${telefono.replace(/\D/g, '')}`;
  if (email) return `mailto:${email}?subject=${encodeURIComponent(nombre)}`;
  return undefined;
};

const pie = (nombre: string): string => {
  if (fichas.has(slugServicio(nombre))) return 'Ver el servicio';
  if (whatsapp) return 'Cotizar por WhatsApp';
  if (telefono) return 'Llamar';
  if (email) return 'Escribir por correo';
  return 'Sin contacto directo';
};

/** Foto declarada en la ficha; si no la hay, selección determinista del catálogo. */
const imagen = (s: ServicioDeclarado, i: number) => {
  if (!hayFotos) return null;
  if (s.foto && grupos.has(s.foto)) return tomarFoto(s.foto, i + 1);
  return fotoPara(`servicio:${rubro}:${s.nombre}`, rubro);
};
---

<section class="wrap pt-16 sm:pt-20">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <p class="label">[ {indice} — Servicios que ofrece ]</p>
    <p class="label muted tabular-nums">{nn(servicios.length)} declarados</p>
  </div>

  <div class="mt-8 grid grid-cols-1 items-stretch gap-5 sm:grid-cols-2 xl:grid-cols-3">
    {servicios.map((s, i) => (
      <Tarjeta
        href={enlace(s.nombre)}
        indice={nn(i + 1)}
        titulo={s.nombre}
        meta={meta}
        descripcion={s.descripcion}
        pie={pie(s.nombre)}
        foto={imagen(s, i)}
        laminaTexto={s.nombre.slice(0, 2)}
        inactivo={!enlace(s.nombre)}
      />
    ))}
  </div>

  {paginas.length > 0 && (
    <p class="mt-8 text-[13px] leading-[1.5]">
      <span class="label muted">Qué incluye cada servicio:</span>{' '}
      {paginas.map((p, i) => (
        <>
          {i > 0 && <span class="muted"> · </span>}
          <a href={p.href} class="text-signal underline-hover">{p.titulo}</a>
        </>
      ))}
    </p>
  )}

  <p class="muted mt-6 max-w-[68ch] text-[13px] leading-[1.5]">
    Los servicios y su alcance los declara la empresa. TuSeguridad no interviene en
    la contratación; confirma directamente con el proveedor la modalidad que ampara
    su permiso.
  </p>
</section>
