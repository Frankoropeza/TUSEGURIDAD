---
import Tarjeta from '@components/Tarjeta.astro';
import type { Distintivo } from '@components/Tarjeta.astro';
import { foto as tomarFoto, fotoPara, tieneFotos } from '@lib/imagenes';

interface Props {
  indice: string;
  nombre: string;
  descripcion: string;
  href: string;
  /** slug del grupo de fotografía declarado en la ficha */
  fotoSlug?: string;
  /** semilla para elegir foto cuando la ficha no declara una */
  semilla: string;
  rubro?: string;
  rubroSlug?: string;
  plazas?: string[];
  servicios?: number;
  zonas?: number;
  verificado?: boolean;
  demo?: boolean;
  sizes?: string;
}

const {
  indice,
  nombre,
  descripcion,
  href,
  fotoSlug,
  semilla,
  rubro,
  rubroSlug,
  plazas = [],
  servicios = 0,
  zonas = 0,
  verificado = false,
  demo = false,
  sizes,
} = Astro.props;

const hayFotos = !rubroSlug || tieneFotos(rubroSlug);
const imagen = hayFotos
  ? fotoSlug
    ? tomarFoto(fotoSlug, parseInt(indice, 10) || 1)
    : fotoPara(semilla, rubroSlug ?? 'seguridad-privada')
  : null;

// Una ficha de maqueta jamás muestra "Verificada": la marca de verificación
// solo puede acompañar a empresas reales con documentación confirmada.
const distintivos: Distintivo[] = [
  ...(demo ? [{ texto: 'Demo', tono: 'ink' as const }] : []),
  ...(verificado && !demo ? [{ texto: 'Verificada', tono: 'signal' as const }] : []),
];

const nn = (n: number): string => String(n).padStart(2, '0');
---

<Tarjeta
  href={href}
  indice={indice}
  titulo={nombre}
  meta={[rubro, plazas.join(' · ')].filter(Boolean).join(' / ')}
  descripcion={descripcion}
  pie={`${nn(servicios)} servicios · ${nn(zonas)} zonas`}
  distintivos={distintivos}
  foto={imagen}
  laminaTexto={nombre.slice(0, 2).toUpperCase()}
  sizes={sizes}
/>
