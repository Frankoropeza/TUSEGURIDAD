---
interface Props {
  /** HTML ya renderizado del Markdown (entry.rendered.html) */
  html: string;
}
const { html } = Astro.props;

/**
 * Parte el HTML del Markdown en apartados por cada <h2> para poder maquetarlos
 * en retícula: el título vive en la columna de margen y el cuerpo en la de
 * lectura. Con <Content /> plano no se puede, porque cada elemento cae en su
 * propia fila.
 */
const trozos = html.split(/<h2[^>]*>([\s\S]*?)<\/h2>/);
const intro = (trozos[0] ?? '').trim();

const apartados: { titulo: string; cuerpo: string }[] = [];
for (let i = 1; i < trozos.length; i += 2) {
  apartados.push({
    titulo: (trozos[i] ?? '').replace(/<[^>]*>/g, '').trim(),
    cuerpo: (trozos[i + 1] ?? '').trim(),
  });
}

const nn = (n: number): string => String(n).padStart(2, '0');
---

{intro && <div class="prose-flujo max-w-[68ch]" set:html={intro} />}

{apartados.length > 0 && (
  <div class:list={['border-t border-ink/20', intro && 'mt-10']}>
    {apartados.map((a, i) => (
      <article class="grid grid-cols-12 gap-x-10 gap-y-5 border-b border-ink/20 py-10 sm:py-12">
        <header class="col-span-12 lg:col-span-4">
          <p class="label text-signal tabular-nums">{nn(i + 1)}</p>
          <h2 class="display-md mt-3">{a.titulo}</h2>
        </header>
        <div
          class="prose-flujo col-span-12 lg:col-span-7 lg:col-start-6"
          set:html={a.cuerpo}
        />
      </article>
    ))}
  </div>
)}
