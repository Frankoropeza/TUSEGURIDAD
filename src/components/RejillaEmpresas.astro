---
import EmpresaCard from '@components/EmpresaCard.astro';
import type { Datos } from '@lib/enlaces';
import { ciudadesDe, zonasDe } from '@lib/enlaces';

interface Props {
  empresas: Datos['empresas'];
  categorias: Datos['categorias'];
  ciudades: Datos['ciudades'];
  /** cuando la rejilla vive dentro de un cruce, se fija el contexto */
  rubroFijo?: string;
  ciudadFija?: string;
  /** constructor del enlace, para respetar la ruta de navegación */
  href: (e: Datos['empresas'][number]) => string;
}

const { empresas, categorias, ciudades, rubroFijo, ciudadFija, href } = Astro.props;

const nombreRubro = new Map(categorias.map((c) => [c.id, c.data.nombre]));
const nombrePlaza = new Map(
  ciudades.map((c) => [c.id, c.data.nombreCorto ?? c.data.nombre])
);
const nn = (n: number): string => String(n).padStart(2, '0');
---

<div class="grid grid-cols-1 items-stretch gap-5 sm:grid-cols-2 xl:grid-cols-3">
  {empresas.map((e, i) => {
    const rubro = rubroFijo ?? e.data.categoria;
    const plazas = ciudadFija ? [ciudadFija] : ciudadesDe(e);
    return (
      <EmpresaCard
        indice={nn(i + 1)}
        nombre={e.data.nombre}
        descripcion={e.data.descripcion}
        href={href(e)}
        fotoSlug={e.data.foto}
        semilla={`${e.id}:${rubro}`}
        rubro={nombreRubro.get(rubro)}
        rubroSlug={rubro}
        plazas={plazas.map((p) => nombrePlaza.get(p) ?? p)}
        servicios={e.data.servicios.length}
        zonas={zonasDe(e, ciudadFija).length}
        verificado={e.data.verificado}
        demo={e.data.demo}
      />
    );
  })}
</div>
