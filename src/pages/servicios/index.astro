---
import BaseLayout from '@layouts/BaseLayout.astro';
import Cabecera from '@components/Cabecera.astro';
import Relacionados from '@components/Relacionados.astro';
import Tarjeta from '@components/Tarjeta.astro';
import { tieneFotos, fotoPara } from '@lib/imagenes';
import { cargarDatos, bloqueRubros, bloqueCiudades, bloqueGuias, bloqueEmpresas } from '@lib/enlaces';

const d = await cargarDatos();
const catPorId = new Map(d.categorias.map((c) => [c.id, c.data.nombre]));
const nn = (n: number): string => String(n).padStart(2, '0');
---

<BaseLayout
  title="Servicios"
  description="Servicios de seguridad más solicitados. Te conectamos con proveedores verificados para cada uno."
  path="/servicios"
  pageType="itemlist"
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Servicios', href: '/servicios' },
  ]}
>
  <Cabecera
    ruta={[{ nombre: 'Inicio', href: '/' }, { nombre: 'Servicios' }]}
    indice="Servicios"
    meta={`${nn(d.servicios.length)} publicados`}
    titulo="Servicios"
    lede="Los servicios de seguridad que más se buscan. Cada uno explica qué incluye y te conecta con los proveedores del rubro correspondiente."
    stats={[
      { k: 'Servicios', v: nn(d.servicios.length) },
      { k: 'Rubros', v: nn(d.categorias.filter((c) => c.data.destacada).length) },
    ]}
  />

  <section class="wrap pt-16 sm:pt-20">
    <div class="grid grid-cols-1 items-stretch gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {d.servicios.map((s, i) => (
        <Tarjeta
          href={`/servicios/${s.id}`}
          indice={nn(i + 1)}
          titulo={s.data.titulo}
          meta={s.data.rubro ? catPorId.get(s.data.rubro) : undefined}
          descripcion={s.data.descripcion}
          pie={`${nn(s.data.faq.length)} preguntas`}
          foto={s.data.rubro && tieneFotos(s.data.rubro) ? fotoPara(`servicio:${s.id}`) : null}
          laminaTexto={s.data.titulo.slice(0, 2)}
        />
      ))}
    </div>
  </section>

  <Relacionados
    indice="01"
    bloques={[
      bloqueRubros(d),
      bloqueEmpresas(d, { limite: 5 }),
      bloqueCiudades(d),
      bloqueGuias(d, { limite: 5 }),
    ]}
  />
</BaseLayout>
