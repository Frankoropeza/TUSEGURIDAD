---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Cabecera from '@components/Cabecera.astro';
import RejillaEmpresas from '@components/RejillaEmpresas.astro';
import Relacionados from '@components/Relacionados.astro';
import Faq from '@components/Faq.astro';
import { getCollection, render } from 'astro:content';
import {
  cargarDatos,
  empresasDeRubro,
  bloqueRubros,
  bloqueCiudades,
  bloqueServicios,
  bloqueGuias,
  hrefEmpresa,
} from '@lib/enlaces';

export const getStaticPaths = (async () => {
  const servicios = await getCollection('servicios');
  return servicios.map((servicio) => ({ params: { id: servicio.id }, props: { servicio } }));
}) satisfies GetStaticPaths;

const { servicio } = Astro.props;
const s = servicio.data;
const { Content } = await render(servicio);

const d = await cargarDatos();
const rubro = s.rubro ? d.categorias.find((c) => c.id === s.rubro) : undefined;
const empresas = s.rubro ? empresasDeRubro(d, s.rubro) : [];

const path = `/servicios/${servicio.id}`;
const nn = (n: number): string => String(n).padStart(2, '0');
---

<BaseLayout
  title={s.titulo}
  description={s.descripcion}
  path={path}
  pageType="service"
  faq={s.faq}
  jsonld={rubro ? { category: rubro.data.nombre } : {}}
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Servicios', href: '/servicios/' },
    { name: s.titulo, href: path },
  ]}
>
  <Cabecera
    ruta={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Servicios', href: '/servicios/' },
      { nombre: s.titulo },
    ]}
    indice="Servicio"
    meta={rubro ? `Rubro: ${rubro.data.nombre}` : undefined}
    titulo={s.titulo}
    lede={s.descripcion}
    stats={[
      { k: 'Proveedores', v: nn(empresas.length) },
      { k: 'Consulta', v: 'Libre' },
    ]}
  />

  <section class="wrap pt-16 sm:pt-20">
    <div class="grid grid-cols-12 gap-x-12 gap-y-12">
      <div class="col-span-12 lg:col-span-8">
        <p class="label">[ 01 — Detalle ]</p>
        <div class="prose-content rule mt-6 pt-8">
          <Content />
        </div>
      </div>

      <aside class="col-span-12 lg:col-span-3 lg:col-start-10">
        {rubro && (
          <>
            <p class="label">[ Rubro ]</p>
            <a href={`/categorias/${rubro.id}/`} class="rule mt-4 block py-4">
              <span class="display-md underline-hover">{rubro.data.nombre}</span>
              <span class="muted mt-2 block text-sm leading-snug">{rubro.data.descripcion}</span>
              <span class="label text-signal mt-3 inline-block">Ver el rubro →</span>
            </a>
          </>
        )}

        <div class="rule mt-10 pt-6">
          <p class="text-sm leading-snug">
            ¿Prestas este servicio? Publica tu ficha y aparece ante quien lo está buscando.
          </p>
          <a href="/registrar/" class="cta-solid mt-6">Solicitar alta →</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- proveedores del rubro -->
  {empresas.length > 0 && (
    <section class="wrap pt-20 sm:pt-28">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <p class="label">[ 02 — Proveedores ]</p>
        {rubro && (
          <a href={`/categorias/${rubro.id}/`} class="label underline-hover">
            Ver todo el rubro →
          </a>
        )}
      </div>

      <h2 class="display-lg mt-8">Quién presta<br />este servicio</h2>

      <RejillaEmpresas
        empresas={empresas.slice(0, 8)}
        categorias={d.categorias}
        ciudades={d.ciudades}
        href={(e) => hrefEmpresa(e)}
      />
    </section>
  )}

  <Faq preguntas={s.faq} indice="03" />

  <Relacionados
    indice="04"
    bloques={[
      bloqueServicios(d, { excluir: servicio.id, titulo: 'Otros servicios' }),
      bloqueRubros(d, { titulo: 'Rubros' }),
      bloqueCiudades(d, { soloRubro: s.rubro, titulo: 'Ciudades' }),
      bloqueGuias(d, { soloRubro: s.rubro, limite: 4, titulo: 'Guías' }),
    ]}
  />
</BaseLayout>
