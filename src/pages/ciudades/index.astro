---
import BaseLayout from '@layouts/BaseLayout.astro';
import Cabecera from '@components/Cabecera.astro';
import Relacionados from '@components/Relacionados.astro';
import Tarjeta from '@components/Tarjeta.astro';
import { cargarDatos, conteoPorCiudad, bloqueRubros, bloqueServicios, bloqueGuias, bloqueEmpresas } from '@lib/enlaces';

const d = await cargarDatos();
const conteo = conteoPorCiudad(d);
const nn = (n: number): string => String(n).padStart(2, '0');
---

<BaseLayout
  title="Ciudades"
  description="Cobertura del directorio de seguridad por ciudad. Consulta proveedores por plaza."
  path="/ciudades"
  pageType="itemlist"
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Ciudades', href: '/ciudades' },
  ]}
>
  <Cabecera
    ruta={[{ nombre: 'Inicio', href: '/' }, { nombre: 'Ciudades' }]}
    indice="Cobertura"
    meta={`${nn(d.ciudades.length)} ${d.ciudades.length === 1 ? 'plaza' : 'plazas'}`}
    titulo="Ciudades"
    lede="Arrancamos en la Ciudad de México y su zona metropolitana. Sumamos plazas conforme verificamos proveedores en cada una."
    stats={[
      { k: 'Ciudades', v: nn(d.ciudades.length) },
      { k: 'Empresas', v: nn(d.empresas.length) },
    ]}
  />

  <section class="wrap pt-16 sm:pt-20">
    <div class="grid grid-cols-1 items-stretch gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {d.ciudades.map((c, i) => {
        const n = conteo.get(c.id) ?? 0;
        return (
          <Tarjeta
            href={`/ciudades/${c.id}`}
            indice={nn(i + 1)}
            titulo={c.data.nombre}
            meta={c.data.normativa?.autoridad ?? c.data.estado}
            descripcion={c.data.descripcion}
            pie={`${nn(n)} ${n === 1 ? 'empresa' : 'empresas'}`}
            distintivos={n > 0 ? [{ texto: 'Con padrón', tono: 'signal' }] : []}
            laminaTexto={c.data.abreviatura ?? c.data.nombre.slice(0, 3)}
          />
        );
      })}
    </div>
  </section>

  <Relacionados
    indice="01"
    bloques={[
      bloqueRubros(d),
      bloqueEmpresas(d, { limite: 5 }),
      bloqueServicios(d),
      bloqueGuias(d, { limite: 5 }),
    ]}
  />
</BaseLayout>
