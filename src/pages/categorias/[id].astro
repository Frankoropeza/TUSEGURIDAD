---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import RejillaEmpresas from '@components/RejillaEmpresas.astro';
import Relacionados from '@components/Relacionados.astro';
import Foto from '@components/Foto.astro';
import { tieneFotos, todasLasFotos } from '@lib/imagenes';
import { getCollection, render } from 'astro:content';
import { SITE } from '@config/site';
import {
  cargarDatos,
  zonasDe,
  bloqueCruces,
  bloqueCiudades,
  bloqueServicios,
  bloqueGuias,
  bloqueEmpresas,
  hrefEmpresaEn,
} from '@lib/enlaces';

export const getStaticPaths = (async () => {
  const categorias = await getCollection('categorias');
  return categorias.map((categoria) => ({
    params: { id: categoria.id },
    props: { categoria },
  }));
}) satisfies GetStaticPaths;

const { categoria } = Astro.props;
const d = categoria.data;
const { Content } = await render(categoria);

const todasCategorias = (await getCollection('categorias')).sort(
  (a, b) => a.data.orden - b.data.orden
);
const ciudades = await getCollection('ciudades');
const nombreCiudad = new Map(ciudades.map((c) => [c.id, c.data.nombre]));

const empresas = (await getCollection('empresas'))
  .filter((e) => e.data.categoria === categoria.id || e.data.categorias.includes(categoria.id))
  .sort((a, b) => {
    if (a.data.verificado !== b.data.verificado) return a.data.verificado ? -1 : 1;
    return b.data.orden - a.data.orden;
  });

const otras = todasCategorias.filter((c) => c.id !== categoria.id);
const datos = await cargarDatos();

// reja de las 32 entidades federativas, agrupada por región
const conteoEstado = new Map<string, number>();
for (const e of datos.empresas) {
  if (![e.data.categoria, ...e.data.categorias].includes(categoria.id)) continue;
  for (const p of new Set([e.data.ciudad, ...e.data.ciudades])) {
    conteoEstado.set(p, (conteoEstado.get(p) ?? 0) + 1);
  }
}
const ORDEN_REGION = ['Centro', 'Norte', 'Occidente', 'Bajío', 'Sur', 'Sureste'];
const regiones = ORDEN_REGION.map((region) => ({
  region,
  estados: datos.ciudades
    .filter((c) => c.data.region === region)
    .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es')),
})).filter((r) => r.estados.length > 0);
const conPadron = datos.ciudades.filter((c) => (conteoEstado.get(c.id) ?? 0) > 0).length;

// fotografía del rubro (solo los rubros que tienen catálogo propio)
const galeria = tieneFotos(categoria.id) ? todasLasFotos() : [];
const totalFotos = galeria.reduce((n, g) => n + g.fotos.length, 0);
const portada = galeria.length > 0 ? galeria[0]!.fotos[0]! : null;

// zonas declaradas por las empresas de este rubro (dato real, no inventado)
const zonas = [...new Set(empresas.flatMap((e) => zonasDe(e)))].sort();

const nn = (n: number): string => String(n).padStart(2, '0');
const titulo = d.tituloSeo ?? d.nombre;
const path = `/categorias/${categoria.id}`;
---

<BaseLayout
  title={titulo}
  description={d.descripcion}
  path={path}
  pageType="category"
  faq={d.faq}
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Categorías', href: '/categorias' },
    { name: d.nombre, href: path },
  ]}
>
  <!-- ================= 01 · CABECERA ================= -->
  <section class="wrap pt-10 sm:pt-14">
    <nav class="label flex flex-wrap items-center gap-2" aria-label="Ruta">
      <a href="/" class="underline-hover">Inicio</a>
      <span class="text-ink/30">/</span>
      <a href="/categorias" class="underline-hover">Categorías</a>
      <span class="text-ink/30">/</span>
      <span class="text-signal">{d.nombre}</span>
    </nav>

    <div class="mt-10 flex items-baseline justify-between gap-4">
      <p class="label">[ Rubro {nn(d.orden)} ]</p>
      <p class="label muted">
        {d.destacada ? 'Activo' : 'En preparación'} · {empresas.length}{' '}
        {empresas.length === 1 ? 'empresa' : 'empresas'}
      </p>
    </div>

    <h1 class="display-xl mt-6">{d.nombre}</h1>

    <div class="rule mt-10 grid grid-cols-12 gap-x-6 gap-y-8 pt-8">
      <p class="lede col-span-12 max-w-3xl lg:col-span-7">
        {d.intro ?? d.descripcion}
      </p>
      <div class="col-span-12 lg:col-span-4 lg:col-start-9">
        <dl>
          <div class="rule flex items-baseline justify-between gap-4 py-3">
            <dt class="label">Empresas</dt>
            <dd class="numeral text-2xl">{nn(empresas.length)}</dd>
          </div>
          <div class="rule flex items-baseline justify-between gap-4 py-3">
            <dt class="label">Modalidades</dt>
            <dd class="numeral text-2xl">{nn(d.modalidades.length)}</dd>
          </div>
          <div class="rule flex items-baseline justify-between gap-4 py-3">
            <dt class="label">Consulta</dt>
            <dd class="numeral text-2xl">Libre</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ================= 01b · PORTADA FOTOGRÁFICA ================= -->
  {portada && (
    <section class="wrap pt-14">
      <div class="foto-banda">
        <Foto foto={portada} prioridad sizes="(min-width: 1680px) 1600px, 100vw" mono />
      </div>
    </section>
  )}

  <!-- ================= 02 · PADRÓN DEL RUBRO ================= -->
  <section class="wrap pt-20 sm:pt-28">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <p class="label">[ 01 — Padrón del rubro ]</p>
      {zonas.length > 0 && <p class="label muted">Zonas: {zonas.join(' · ')}</p>}
    </div>

    <h2 class="display-lg mt-8">Proveedores<br />en este rubro</h2>

    {empresas.length > 0 ? (
      <RejillaEmpresas
        empresas={empresas}
        categorias={datos.categorias}
        ciudades={datos.ciudades}
        rubroFijo={categoria.id}
        href={(e) => hrefEmpresaEn(e, categoria.id, e.data.ciudad)}
      />
    ) : (
      <div class="rule mt-12 py-14">
        <p class="display-md">Sin proveedores publicados todavía</p>
        <p class="muted mt-4 max-w-xl text-base leading-snug">
          Estamos verificando las primeras empresas de este rubro. Publicamos una ficha solo
          cuando podemos confirmar registro y datos de contacto.
        </p>
        <a href="/registrar" class="cta-solid mt-8">Registrar mi empresa →</a>
      </div>
    )}
  </section>

  <!-- ================= 02b · SELECTOR DE ESTADO ================= -->
  {d.destacada && (
    <section id="estados" class="wrap pt-20 sm:pt-28">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <p class="label">[ 02 — Elige tu estado ]</p>
        <p class="label muted">
          32 entidades · {nn(conPadron)} con padrón
        </p>
      </div>

      <h2 class="display-lg mt-8 max-w-5xl">
        ¿En qué estado<br />lo <span class="text-signal">necesitas?</span>
      </h2>

      <p class="muted mt-8 max-w-2xl text-base leading-snug">
        La autorización de seguridad privada se otorga por entidad y las reglas cambian entre
        estados: la vigencia va de un año a cinco, y el catálogo de modalidades va de tres a once.
        Elige el tuyo para ver a los proveedores y la normativa que aplica.
      </p>

      {regiones.map((grupo) => (
        <div class="mt-12">
          <p class="label rule text-signal pt-4">{grupo.region}</p>
          <div class="mt-4 grid grid-cols-2 gap-px sm:grid-cols-3 lg:grid-cols-4">
            {grupo.estados.map((c) => {
              const n = conteoEstado.get(c.id) ?? 0;
              return (
                <a
                  href={`/categorias/${categoria.id}/${c.id}`}
                  class:list={[
                    'group flex flex-col justify-between border-b border-r border-ink/15 p-4 hover:bg-ink hover:text-paper',
                    n > 0 && 'bg-bone/60',
                  ]}
                >
                  <span class="flex items-baseline justify-between gap-2">
                    <span class="label muted group-hover:text-paper/55">{c.data.abreviatura}</span>
                    {n > 0 && <span class="label text-signal">{nn(n)}</span>}
                  </span>
                  <span class="display-sm mt-6 block">{c.data.nombre}</span>
                  <span class="label muted group-hover:text-paper/55 mt-2 block">
                    {n > 0 ? `${n} ${n === 1 ? 'empresa' : 'empresas'}` : 'Sin padrón aún'}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </section>
  )}

  <!-- ================= 03 · MODALIDADES ================= -->
  {d.modalidades.length > 0 && (
    <section class="wrap pt-20 sm:pt-28">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <p class="label">[ 02 — Modalidades ]</p>
        <p class="label muted">Marco normativo federal</p>
      </div>

      <h2 class="display-lg mt-8 max-w-4xl">Qué cubre<br />cada modalidad</h2>

      <p class="muted mt-8 max-w-2xl text-base leading-snug">
        La autorización se otorga por modalidad: delimita lo que la empresa puede prestar
        legalmente. Confirma que la del proveedor cubra el servicio que vas a contratar.
      </p>

      <div class="mt-12 border-b border-ink/20">
        {d.modalidades.map((m, i) => {
          const Tag = m.rubro ? 'a' : 'div';
          return (
            <Tag
              href={m.rubro ? `/categorias/${m.rubro}` : undefined}
              class:list={[
                'grid grid-cols-12 items-baseline gap-x-4 gap-y-2 py-7',
                m.rubro ? 'idx-row' : 'border-t border-ink/20',
              ]}
            >
              <span class="label col-span-2 sm:col-span-1">{nn(i + 1)}</span>
              <span class="display-md col-span-10 sm:col-span-4">{m.nombre}</span>
              <span class="muted col-span-12 text-sm leading-snug sm:col-span-6">
                {m.descripcion}
              </span>
              {m.rubro && <span class="idx-arrow label col-span-12 sm:col-span-1 sm:text-right">→</span>}
            </Tag>
          );
        })}
      </div>
    </section>
  )}

  <!-- ================= 04 · CONTENIDO EDITORIAL ================= -->
  <section class="wrap pt-20 sm:pt-28">
    <p class="label">[ 03 — Contexto ]</p>
    <div class="rule mt-8 grid grid-cols-12 gap-x-12 gap-y-10 pt-10">
      <div class="col-span-12 lg:col-span-8">
        <div class="prose-content">
          <Content />
        </div>
      </div>

      {d.fuentes.length > 0 && (
        <aside class="col-span-12 lg:col-span-3 lg:col-start-10">
          <p class="label muted">Fuentes</p>
          <ul class="mt-5">
            {d.fuentes.map((f) => (
              <li class="rule py-3">
                <a href={f.url} rel="noopener nofollow" target="_blank" class="label underline-hover block leading-relaxed">
                  {f.titulo} ↗
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </section>

  <!-- ================= 05 · VERIFICACIÓN ================= -->
  {d.verificacion.length > 0 && (
    <section class="on-ink mt-20 sm:mt-28">
      <div class="wrap py-20 sm:py-28">
        <p class="label muted">[ 04 — Lista de verificación ]</p>
        <h2 class="display-lg mt-10 max-w-5xl">
          Qué revisar<br />antes de <span class="text-signal">firmar</span>
        </h2>

        <div class="mt-14 grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {d.verificacion.map((v, i) => (
            <div class="rule pt-5">
              <p class="label text-signal">/{nn(i + 1)}</p>
              <h3 class="display-md mt-4">{v.punto}</h3>
              <p class="muted mt-3 text-sm leading-snug">{v.detalle}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ================= 06 · PREGUNTAS FRECUENTES ================= -->
  {d.faq.length > 0 && (
    <section class="wrap pt-20 sm:pt-28">
      <div class="flex items-baseline justify-between gap-4">
        <p class="label">[ 05 — Preguntas frecuentes ]</p>
        <p class="label muted">{nn(d.faq.length)}</p>
      </div>

      <h2 class="display-lg mt-8">Dudas<br />frecuentes</h2>

      <dl class="mt-12 border-b border-ink/20">
        {d.faq.map((f, i) => (
          <div class="rule grid grid-cols-12 items-start gap-x-6 gap-y-3 py-8">
            <dt class="col-span-12 flex gap-4 sm:col-span-5">
              <span class="label mt-1 shrink-0 text-signal">{nn(i + 1)}</span>
              <span class="display-sm">{f.q}</span>
            </dt>
            <dd class="col-span-12 max-w-2xl text-base leading-snug sm:col-span-6 sm:col-start-7">
              {f.a}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <!-- ================= 07 · OTROS RUBROS ================= -->
  <section class="wrap pt-20 sm:pt-28">
    <p class="label">[ 06 — Otros rubros ]</p>
    <div class="mt-8 border-b border-ink/20">
      {otras.map((c, i) => (
        <a
          href={`/categorias/${c.id}`}
          class="idx-row grid grid-cols-12 items-baseline gap-x-4 gap-y-2 py-6"
        >
          <span class="label col-span-2 sm:col-span-1">{nn(i + 1)}</span>
          <span class="display-md col-span-10 sm:col-span-4">{c.data.nombre}</span>
          <span class="muted col-span-12 text-sm leading-snug sm:col-span-6">
            {c.data.descripcion}
          </span>
          <span class="idx-arrow label col-span-12 sm:col-span-1 sm:text-right">
            {c.data.destacada ? '→' : '·'}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ================= 06b · GALERÍA DEL RUBRO ================= -->
  {galeria.length > 0 && (
    <section class="wrap pt-20 sm:pt-28">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <p class="label">[ 06 — El rubro en imágenes ]</p>
        <p class="label muted">{nn(galeria.length)} escenarios · {totalFotos} fotografías</p>
      </div>

      <h2 class="display-lg mt-8 max-w-4xl">Cómo se ve<br />el servicio</h2>

      <p class="muted mt-8 max-w-2xl text-base leading-snug">
        Escenarios reales de operación del rubro: control de acceso, patrullaje, monitoreo y
        vigilancia perimetral en distintos tipos de inmueble.
      </p>

      {galeria.map(({ grupo, fotos }, gi) => (
        <div class="mt-14">
          <div class="rule flex flex-wrap items-baseline justify-between gap-3 pt-4">
            <p class="label">
              <span class="text-signal">{nn(gi + 1)}</span>&nbsp; {grupo.titulo}
            </p>
            <p class="label muted">{nn(fotos.length)}</p>
          </div>

          <div class="mt-4 grid grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8">
            {fotos.map((f) => (
              <figure class="foto-marco">
                <Foto foto={f} sizes="(min-width: 1280px) 12vw, (min-width: 1024px) 16vw, 33vw" mono />
              </figure>
            ))}
          </div>
        </div>
      ))}
    </section>
  )}

  <Relacionados
    indice="07"
    bloques={[
      bloqueCruces(datos, { rubro: categoria.id, titulo: 'Este rubro por plaza' }),
      bloqueCiudades(datos, { soloRubro: categoria.id, titulo: 'Ciudades con presencia' }),
      bloqueServicios(datos, { soloRubro: categoria.id, titulo: 'Servicios del rubro' }),
      bloqueGuias(datos, { soloRubro: categoria.id, limite: 4, titulo: 'Guías del rubro' }),
      bloqueEmpresas(datos, { rubro: categoria.id, limite: 5, titulo: 'Proveedores' }),
    ]}
  />

  <!-- ================= 08 · CTA ================= -->
  <section class="wrap pt-20 sm:pt-28">
    <div class="rule-strong grid grid-cols-12 items-end gap-x-6 gap-y-10 pt-10">
      <h2 class="display-lg col-span-12 lg:col-span-7">
        ¿Prestas este<br /><span class="text-signal">servicio?</span>
      </h2>
      <div class="col-span-12 lg:col-span-4 lg:col-start-9">
        <p class="text-base leading-snug">
          Publica tu ficha en el rubro de {d.nombre.toLowerCase()} de {SITE.name}. Revisamos
          autorización, modalidad y datos de contacto antes de publicar.
        </p>
        <a href="/registrar" class="cta-solid mt-8">Solicitar alta →</a>
      </div>
    </div>
  </section>
</BaseLayout>
