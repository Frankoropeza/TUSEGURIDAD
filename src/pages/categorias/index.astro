---
import BaseLayout from '@layouts/BaseLayout.astro';
import Tarjeta from '@components/Tarjeta.astro';
import { tieneFotos, fotoPara } from '@lib/imagenes';
import Relacionados from '@components/Relacionados.astro';
import { getCollection } from 'astro:content';
import { cargarDatos, bloqueCruces, bloqueCiudades, bloqueServicios, bloqueGuias, bloqueEmpresas } from '@lib/enlaces';

const todas = (await getCollection('categorias')).sort((a, b) => a.data.orden - b.data.orden);
const activas = todas.filter((c) => c.data.destacada);
const proximas = todas.filter((c) => !c.data.destacada);

const empresas = await getCollection('empresas');
const conteo = new Map<string, number>();
for (const e of empresas) {
  for (const slug of new Set([e.data.categoria, ...e.data.categorias])) {
    conteo.set(slug, (conteo.get(slug) ?? 0) + 1);
  }
}

const nn = (n: number): string => String(n).padStart(2, '0');
const d = await cargarDatos();
---

<BaseLayout
  title="Categorías"
  description="Rubros del directorio de seguridad: seguridad privada y protección contra incendios, con más especialidades en preparación."
  path="/categorias"
  pageType="itemlist"
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Categorías', href: '/categorias' },
  ]}
>
  <section class="wrap pt-10 sm:pt-14">
    <nav class="label flex flex-wrap items-center gap-2" aria-label="Ruta">
      <a href="/" class="underline-hover">Inicio</a>
      <span class="text-ink/30">/</span>
      <span class="text-signal">Categorías</span>
    </nav>

    <div class="mt-10 flex items-baseline justify-between gap-4">
      <p class="label">[ Índice de rubros ]</p>
      <p class="label muted">
        {nn(activas.length)} activos · {nn(proximas.length)} en preparación
      </p>
    </div>

    <h1 class="display-xl mt-6">Rubros</h1>

    <p class="lede rule mt-10 max-w-3xl pt-8">
      El directorio se organiza por rubro. Cada uno reúne a los proveedores del ramo y explica
      qué revisar antes de contratar.
    </p>
  </section>

  <section class="wrap pt-16 sm:pt-20">
    <div class="grid grid-cols-1 items-stretch gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {todas.map((cat, i) => {
        const n = conteo.get(cat.id) ?? 0;
        return (
          <Tarjeta
            href={`/categorias/${cat.id}`}
            indice={nn(i + 1)}
            titulo={cat.data.nombre}
            meta={cat.data.destacada ? 'Rubro activo' : 'En preparación'}
            descripcion={cat.data.descripcion}
            pie={
              cat.data.destacada
                ? `${nn(n)} ${n === 1 ? 'empresa' : 'empresas'}`
                : 'Sin padrón'
            }
            distintivos={cat.data.destacada && n > 0 ? [{ texto: 'Con padrón', tono: 'signal' }] : []}
            foto={tieneFotos(cat.id) ? fotoPara(`rubro:${cat.id}`, cat.id) : null}
            laminaTexto={cat.data.nombre.slice(0, 2)}
            inactivo={!cat.data.destacada}
          />
        );
      })}
    </div>
  </section>

  <Relacionados
    indice="01"
    titulo="Buscar por rubro y plaza"
    bloques={[
      bloqueCruces(d),
      bloqueCiudades(d, { titulo: 'Plazas' }),
      bloqueEmpresas(d, { limite: 5 }),
      bloqueServicios(d),
      bloqueGuias(d, { limite: 4 }),
    ]}
  />
</BaseLayout>
