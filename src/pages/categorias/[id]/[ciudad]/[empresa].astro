---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Cabecera from '@components/Cabecera.astro';
import Relacionados from '@components/Relacionados.astro';
import ServiciosEmpresa from '@components/ServiciosEmpresa.astro';
import ServicioDetalle from '@components/ServicioDetalle.astro';
import { serviciosDe } from '@lib/servicios';
import { getCollection, render } from 'astro:content';
import {
  cargarDatos,
  rubrosDe,
  ciudadesDe,
  zonasDe,
  bloqueCruces,
  bloqueRubros,
  bloqueCiudades,
  bloqueServicios,
  bloqueGuias,
  bloqueEmpresas,
  hrefEmpresa,
  hrefEmpresaEn,
} from '@lib/enlaces';

/**
 * Ficha de empresa anidada bajo rubro y plaza, para que la URL espeje la
 * navegación (Inicio → Rubro → Estado → Empresa).
 *
 * Una empresa que opera en varias plazas o rubros genera varias variantes con
 * el mismo contenido. Solo la combinación principal (categoria + ciudad del
 * frontmatter) es indexable; el resto llevan rel=canonical hacia ella y salen
 * con noindex, de modo que el duplicado no compite consigo mismo.
 */
export const getStaticPaths = (async () => {
  const [empresas, categorias] = await Promise.all([
    getCollection('empresas'),
    getCollection('categorias'),
  ]);
  const activos = new Set(categorias.filter((c) => c.data.destacada).map((c) => c.id));

  return empresas.flatMap((empresa) => {
    const rubros = [...new Set([empresa.data.categoria, ...empresa.data.categorias])].filter((r) =>
      activos.has(r)
    );
    const plazas = [...new Set([empresa.data.ciudad, ...empresa.data.ciudades])];
    return rubros.flatMap((rubro) =>
      plazas.map((plaza) => ({
        params: { id: rubro, ciudad: plaza, empresa: empresa.id },
        props: { empresa, rubro, plaza },
      }))
    );
  });
}) satisfies GetStaticPaths;

const { empresa, rubro, plaza } = Astro.props;
const e = empresa.data;
const { Content } = await render(empresa);

const d = await cargarDatos();
const catPorId = new Map(d.categorias.map((c) => [c.id, c.data.nombre]));
const ciudadPorId = new Map(d.ciudades.map((c) => [c.id, c.data.nombre]));
const ciudadCorta = new Map(
  d.ciudades.map((c) => [c.id, c.data.nombreCorto ?? c.data.nombre])
);

const rubros = rubrosDe(empresa);
const plazas = ciudadesDe(empresa);
const ciudad = ciudadPorId.get(e.ciudad);
const rubrosActivos = new Set(d.categorias.filter((c) => c.data.destacada).map((c) => c.id));

const path = hrefEmpresaEn(empresa, rubro, plaza);
const canonicalPath = hrefEmpresa(empresa);
const esCanonica = path === canonicalPath;

const nombreRubro = catPorId.get(rubro) ?? rubro;
const nombrePlaza = ciudadPorId.get(plaza) ?? plaza;
const nn = (n: number): string => String(n).padStart(2, '0');

/** wa.me exige el número a 12 dígitos con lada país; los .md guardan el formato legible. */
const waLink = (n: string): string => {
  const d = n.replace(/\D/g, '');
  return `https://wa.me/${d.length === 10 ? `52${d}` : d}`;
};

// contacto declarado (solo lo que existe — nada inventado)
const contacto = [
  e.telefono && { k: 'Teléfono', v: e.telefono, href: `tel:+52${e.telefono.replace(/\D/g, '')}` },
  e.whatsapp && { k: 'WhatsApp', v: e.whatsapp, href: waLink(e.whatsapp) },
  e.email && { k: 'Correo', v: e.email, href: `mailto:${e.email}` },
  e.sitio && {
    k: 'Sitio web',
    v: e.sitio.replace(/^https?:\/\//, '').replace(/\/$/, ''),
    href: e.sitio,
  },
].filter(Boolean) as { k: string; v: string; href: string }[];

const ficha = [
  { k: 'Rubro principal', v: catPorId.get(e.categoria) ?? e.categoria },
  { k: 'Plazas', v: plazas.map((p) => ciudadPorId.get(p) ?? p).join(' · ') },
  e.direccion && { k: 'Dirección', v: e.direccion },
  e.horario && { k: 'Horario', v: e.horario },
  /* Valoración del perfil público, siempre atribuida y fechada. No se emite
     como aggregateRating: no es una reseña de este sitio. */
  e.resenas && {
    k: 'Calificación pública',
    v: `${e.resenas.calificacion.toFixed(1)} de 5 · ${e.resenas.total} ${
      e.resenas.total === 1 ? 'reseña' : 'reseñas'
    }${e.fuenteDatos ? ` en ${e.fuenteDatos.nombre}` : ''}`,
  },
  /* Cruce con el padrón. La redacción del caso negativo importa tanto como la
     del positivo: no aparecer en un padrón por modalidad no acredita nada en
     contra de la empresa. */
  e.padron &&
    (e.padron.localizada
      ? {
          k: 'Padrón oficial',
          v: `Localizada en el padrón de ${e.padron.modalidad.toLowerCase()}${
            e.padron.expediente ? `, expediente ${e.padron.expediente}` : ''
          }${e.padron.vigencia ? `, vigencia declarada al ${e.padron.vigencia}` : ''}`,
        }
      : {
          k: 'Padrón oficial',
          v: `No localizada en el padrón de ${e.padron.modalidad.toLowerCase()} publicado por la autoridad. Ese padrón cubre una sola modalidad, así que la ausencia no implica falta de permiso en otra.`,
        }),
].filter(Boolean) as { k: string; v: string }[];

// zonas agrupadas por plaza — así se ve dónde cubre exactamente en cada una
const zonasPorPlaza = plazas
  .map((p) => ({ plaza: p, nombre: ciudadPorId.get(p) ?? p, zonas: zonasDe(empresa, p) }))
  .filter((x) => x.zonas.length > 0);

/* Servicios declarados. Abren la ficha: quien llega buscando a la empresa
   quiere saber primero qué hace, no su domicilio fiscal. */
const servicios = serviciosDe(empresa);

/* Páginas de servicio del directorio referidas desde el frontmatter — solo
   las que existen de verdad, para no generar enlaces rotos. */
const servicioPorId = new Map(d.servicios.map((s) => [s.id, s.data.titulo]));
const paginasServicio = [
  ...new Map(
    servicios
      .map((s) => s.servicio)
      .filter((slug): slug is string => Boolean(slug) && servicioPorId.has(slug!))
      .map((slug) => [slug, { href: `/servicios/${slug}/`, titulo: servicioPorId.get(slug)! }])
  ).values(),
];

/* Servicios con apartado extendido: salen además en el módulo a dos columnas. */
const conDetalle = servicios.filter((s) => s.detalle);

/* Páginas propias de servicio (cliente VIP). La tarjeta lleva ahí en vez de a
   WhatsApp: es una ruta indexable y la conversión ocurre dentro de la página. */
const propias = await getCollection('serviciosEmpresa');
const fichasServicio = new Map(
  propias
    .filter((x) => x.data.empresa === empresa.id)
    .map((x) => [x.data.slug, `${path}${x.data.slug}/`] as const)
);

/* Numeración de apartados: se calcula sobre los que realmente se renderizan,
   para que una ficha sin servicios o sin zonas no salte números. */
const secciones = [
  servicios.length > 0 && 'servicios',
  conDetalle.length > 0 && 'detalle',
  'datos',
  zonasPorPlaza.length > 0 && 'cobertura',
].filter(Boolean) as string[];
const idx = (k: string): string => nn(secciones.indexOf(k) + 1);

// JSON-LD LocalBusiness — sin aggregateRating ni reseñas fabricadas
const jsonld: Record<string, unknown> = {
  ...(e.telefono ? { telephone: e.telefono } : {}),
  ...(e.email ? { email: e.email } : {}),
  ...(e.sitio ? { sameAs: [e.sitio] } : {}),
  ...(e.direccion || ciudad
    ? {
        address: {
          '@type': 'PostalAddress',
          ...(e.direccion ? { streetAddress: e.direccion } : {}),
          ...(ciudad ? { addressLocality: ciudad } : {}),
          addressCountry: 'MX',
        },
      }
    : {}),
  ...(e.horario ? { openingHours: e.horario } : {}),
  // catálogo de servicios declarados — hecho, no valoración
  ...(servicios.length > 0
    ? {
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: `Servicios de ${e.nombre}`,
          itemListElement: servicios.map((s) => ({
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: s.nombre,
              ...(s.descripcion ? { description: s.descripcion } : {}),
            },
          })),
        },
      }
    : {}),
};
---

<BaseLayout
  title={e.tituloSeo ?? e.nombre}
  description={e.descripcion}
  path={path}
  canonicalPath={canonicalPath}
  noindex={!esCanonica || e.demo}
  pageType="business"
  jsonld={jsonld}
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Categorías', href: '/categorias/' },
    { name: nombreRubro, href: `/categorias/${rubro}/` },
    { name: nombrePlaza, href: `/categorias/${rubro}/${plaza}/` },
    { name: e.nombre, href: path },
  ]}
>
  <Cabecera
    ruta={[
      { nombre: 'Inicio', href: '/' },
      { nombre: 'Categorías', href: '/categorias/' },
      { nombre: nombreRubro, href: `/categorias/${rubro}/` },
      { nombre: ciudadCorta.get(plaza) ?? nombrePlaza, href: `/categorias/${rubro}/${plaza}/` },
      { nombre: e.nombre },
    ]}
    indice="Ficha de empresa"
    meta={e.demo ? 'Ficha de maqueta' : e.verificado ? 'Verificada' : 'Sin verificar'}
    titulo={e.nombre}
    lede={e.descripcion}
  />

  <!-- lo que ofrece: primero, antes que los datos administrativos -->
  {servicios.length > 0 && (
    <ServiciosEmpresa
      indice={idx('servicios')}
      servicios={servicios}
      rubro={rubro}
      rubroNombre={nombreRubro}
      whatsapp={e.whatsapp}
      telefono={e.telefono}
      email={e.email}
      plaza={ciudadCorta.get(plaza) ?? nombrePlaza}
      paginas={paginasServicio}
      fichas={fichasServicio}
    />
  )}

  <!-- servicio en detalle: argumento + galería -->
  {conDetalle.length > 0 && (
    <ServicioDetalle
      indice={idx('detalle')}
      servicios={conDetalle}
      paginas={servicioPorId}
      rubroNombre={nombreRubro}
      plaza={ciudadCorta.get(plaza) ?? nombrePlaza}
      whatsapp={e.whatsapp}
      telefono={e.telefono}
      email={e.email}
      fichas={fichasServicio}
    />
  )}

  <!-- ficha de datos + contacto -->
  <section class="wrap pt-16 sm:pt-20">
    <div class="grid grid-cols-12 gap-x-12 gap-y-12">
      <div class="col-span-12 lg:col-span-7">
        <p class="label">[ {idx('datos')} — {e.fuenteDatos ? 'Datos publicados' : 'Datos declarados'} ]</p>
        {e.fuenteDatos && (
          <p class="muted mt-4 text-sm leading-snug">
            Reproducidos de {e.fuenteDatos.nombre}, consultado el {e.fuenteDatos.fechaCorte}.
            TuSeguridad no los verifica ni interviene en la contratación.
          </p>
        )}
        <dl class="mt-6 border-b border-ink/20">
          {ficha.map((f) => (
            <div class="rule grid grid-cols-12 items-baseline gap-4 py-4">
              <dt class="label col-span-12 sm:col-span-4">{f.k}</dt>
              <dd class="col-span-12 text-base leading-snug sm:col-span-8">{f.v}</dd>
            </div>
          ))}
        </dl>

        {zonasPorPlaza.length > 0 && (
          <>
            <p class="label mt-14">[ {idx('cobertura')} — Cobertura declarada ]</p>
            <div class="mt-6 border-b border-ink/20">
              {zonasPorPlaza.map((x) => (
                <div class="rule grid grid-cols-12 items-baseline gap-4 py-4">
                  <a href={`/ciudades/${x.plaza}/`} class="col-span-12 sm:col-span-4">
                    <span class="label text-signal underline-hover">{x.nombre} →</span>
                  </a>
                  <p class="col-span-12 text-base leading-snug sm:col-span-8">
                    {x.zonas.join(' · ')}
                  </p>
                </div>
              ))}
            </div>
          </>
        )}

        <div class="prose-content mt-14">
          <Content />
        </div>
      </div>

      <!-- columna de contacto -->
      <aside class="col-span-12 lg:col-span-4 lg:col-start-9">
        <p class="label">[ Contacto ]</p>
        {contacto.length > 0 ? (
          <ul class="mt-6 border-b border-ink/20">
            {contacto.map((c) => (
              <li class="rule py-3.5">
                <p class="label muted">{c.k}</p>
                <a href={c.href} rel="noopener" class="mt-1 block text-base leading-snug underline-hover">
                  {c.v}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="rule mt-6 py-6">
            <p class="muted text-sm leading-snug">
              Esta empresa aún no publica datos de contacto en el directorio.
            </p>
          </div>
        )}

        <p class="label mt-10">[ Rubros ]</p>
        <ul class="mt-4 border-b border-ink/20">
          {rubros.map((r) => (
            <li class="rule">
              <a href={`/categorias/${r}/`} class="flex items-baseline justify-between gap-3 py-3">
                <span class="text-sm leading-snug underline-hover">{catPorId.get(r) ?? r}</span>
                <span class="label muted">→</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="label mt-10">[ Plazas ]</p>
        <ul class="mt-4 border-b border-ink/20">
          {plazas.map((p) => (
            <li class="rule">
              <a href={`/ciudades/${p}/`} class="flex items-baseline justify-between gap-3 py-3">
                <span class="text-sm leading-snug underline-hover">{ciudadPorId.get(p) ?? p}</span>
                <span class="label muted">→</span>
              </a>
            </li>
          ))}
        </ul>

        <!-- cruces rubro × plaza donde aparece esta empresa -->
        <p class="label mt-10">[ Aparece en ]</p>
        <ul class="mt-4 border-b border-ink/20">
          {rubros.filter((r) => rubrosActivos.has(r)).flatMap((r) =>
            plazas.map((p) => (
              <li class="rule">
                <a href={`/categorias/${r}/${p}/`} class="flex items-baseline justify-between gap-3 py-3">
                  <span class="text-sm leading-snug underline-hover">
                    {catPorId.get(r)} en {ciudadPorId.get(p)}
                  </span>
                  <span class="label muted">→</span>
                </a>
              </li>
            ))
          )}
        </ul>

        <div class="rule mt-10 pt-6">
          <p class="muted text-sm leading-snug">
            Los datos los declara la empresa. Si detectas información incorrecta, avísanos.
          </p>
          <a href="/contacto/" class="label underline-hover mt-4 inline-block">Reportar un dato →</a>
        </div>
      </aside>
    </div>
  </section>

  <Relacionados
    indice={nn(secciones.length + 1)}
    titulo="Seguir explorando"
    bloques={[
      bloqueCruces(d, { rubro: e.categoria, titulo: 'Este rubro por plaza' }),
      bloqueEmpresas(d, { excluir: empresa.id, rubro: e.categoria, titulo: 'Mismo rubro', limite: 5 }),
      bloqueEmpresas(d, { excluir: empresa.id, ciudad: e.ciudad, titulo: 'Misma ciudad', limite: 5 }),
      bloqueRubros(d, { titulo: 'Otros rubros' }),
      bloqueGuias(d, { soloRubro: e.categoria, limite: 4, titulo: 'Guías del rubro' }),
      bloqueServicios(d, { soloRubro: e.categoria, titulo: 'Servicios' }),
      bloqueCiudades(d, { excluir: e.ciudad, titulo: 'Otras ciudades' }),
    ]}
  />
</BaseLayout>
